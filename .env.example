# StableFlow hosts (server)
STABLEFLOW_API_BASE=https://test-api.stableflow.ai

# Public demo origin used for success_url
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set true to validate CHECKOUT_RECIPIENT against the selected network (default off)
NEXT_PUBLIC_VALIDATE_CHECKOUT_RECIPIENT=false

# Server-only: webhook HMAC signing secret (never commit the real value)
STABLEFLOW_WEBHOOK_SECRET=
