{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "stableflow-pay-demo",
  "compatibility_date": "2025-05-05",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "vars": {
    "STABLEFLOW_API_BASE": "https://test-api.stableflow.ai",
    "NEXT_PUBLIC_APP_URL": "https://demo.pay.stableflow.ai"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "stableflow-pay-demo"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pay-demo",
      "database_id": "2aa4f240-7beb-4597-983c-9b47106de5e0",
      "migrations_dir": "migrations"
    }
  ]
}
