{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "stableflow-pay-demo",
  "compatibility_date": "2025-05-05",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "vars": {
    "STABLEFLOW_API_BASE": "https://test-api.stableflow.ai",
    "NEXT_PUBLIC_APP_URL": "https://demo.pay.stableflow.ai",
    "NEXT_PUBLIC_VALIDATE_CHECKOUT_RECIPIENT": "false",
    "NEXT_PUBLIC_PAY_API_KEY": "Rh6nJMMXnqOMJk5jlNHxox7atvIClGGI8fypyXxoweJ8jaZ2VH3atM04ide62RNz"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "stableflow-pay-demo"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pay-demo",
      "database_id": "15ae7afc-8f82-424c-8f29-a999d4014a4e",
      "migrations_dir": "migrations"
    }
  ]
}
